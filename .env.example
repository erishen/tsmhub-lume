# tsm-hub 上游（本机直连默认 9070；Docker 里通常是 http://host.docker.internal:9070）
TSM_BASE=http://127.0.0.1:9070

# tsm-hub 管理口令。注意：Lume 的 env() 会屏蔽名字里含 TOKEN / SECRET /
# API_KEY / PASSWORD / CREDENTIAL 的变量，所以这里不能叫 TSM_ADMIN_TOKEN。
TSM_ADMIN=change-me
# 也可以放文件里（优先于 TSM_ADMIN；适合生产/容器 secret 挂载）
# TSM_ADMIN_FILE=.data/admin.token

# 写操作审批闸门：off（默认）| execute（需 agent_operator）| approve（需 human_admin）
TSM_WRITE_GATE=off

# 可选：Playground 用的客户端 Key（sk-tr-…）。留空则页面给出提示。
TSM_CLIENT_KEY=

# ---- lume agent（框架原生 /react/api/chat 聊天页）----
# 由 agent-httpd 在 C 层直接读取（不走 DSL env()，名字含 API_KEY 不受屏蔽规则影响）。
# LLM_API_URL 指向 tsm-hub 的 OpenAI 兼容端点；LLM_API_KEY 留空 = 内置离线演示引擎。
# Docker 里默认走容器网络，LLM_API_KEY 复用 TSM_CLIENT_KEY（见 docker-compose.yml）。
LLM_API_URL=http://127.0.0.1:9070/v1
LLM_MODEL=auto
LLM_TIMEOUT=120
# LLM_API_KEY=sk-tr-…

# Lume 监听
LUME_BIND=127.0.0.1
LUME_PORT=8097

# 对外暴露时设置 Basic Auth（htpasswd 文件路径）
HTPASSWD_FILE=
