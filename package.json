{
  "name": "tsmhub-lume-web",
  "private": true,
  "version": "0.1.0",
  "description": "tsm-hub 的 Lume BFF React 控制台：esbuild 打包到 www/app.js，由 Lume docroot 直接伺服。",
  "type": "module",
  "scripts": {
    "build": "esbuild src/web/main.tsx --bundle --minify --format=esm --jsx=automatic --outfile=www/app.js",
    "dev": "esbuild src/web/main.tsx --bundle --format=esm --jsx=automatic --outfile=www/app.js --watch",
    "typecheck": "tsc -p tsconfig.json",
    "test-fe": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.24.2",
    "jsdom": "^24.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
