// tsmhub_lume.lume — tsm-hub 的 Lume BFF + React 控制台
//
// 形态：Lume 单进程 = 静态站（www/）+ SPA 回退 + 同源 JSON API。
// 浏览器不直连 tsm-hub：所有 /api/* 在这里转发/聚合，管理口令留在服务端。
//
//   GET    /                         React 控制台
//   GET    /api/health               本服务 + 上游 tsm-hub 健康检查
//   GET    /api/meta                 上游地址 + 写操作闸门策略
//   GET    /api/overview             首屏聚合（概览/告警/健康/审计）
//   GET    /api/providers            上游 Provider 列表
//   POST   /api/providers            新增/更新 Provider（execute）
//   POST   /api/providers/probe      探测模型（execute）
//   DELETE /api/providers/:id        删除 Provider（approve）
//   GET    /api/settings /api/providers /routes /keys /usage /observability /audit-logs ...
//   POST   /api/chat                 可选 Playground（TSM_CLIENT_KEY）
//   POST   /react/api/chat           lume 原生 agent 聊天（框架层拦截，脚本不注册；
//                                    工具=上方只读 tool + LLM_API_URL 上游）
//   GET/POST /v1/*                    token 转发服务：LLM 客户端 API 透传到上游 /v1/*
//
// 环境变量见 .env.example / README.md。

let lc_bind = env("LUME_BIND");
if (lc_bind == null) { lc_bind = "127.0.0.1"; }
let lc_port = env("LUME_PORT");
if (lc_port == null) { lc_port = "8097"; }

server {
  port = int(lc_port);
  workers = 2;
  bind = str(lc_bind);
  docroot = "./www";
  spa = true;                       // history 路由：GET + 静态 404 → www/index.html
  htpasswd = env("HTPASSWD_FILE");  // 本地留空 = 无认证；对外部署注入即开 Basic Auth
};

import "src/api.lume" as api;
import "src/guard.lume" as guard;

// 原样转发查询串（?days= &limit= &offset= &role= …）。
func qs(req) {
  let raw = get(req, "query", "");
  if (raw == null) { return ""; }
  let s = str(raw);
  if (len(s) == 0) { return ""; }
  return "?" + s;
}

// 路径参数重编码：框架捕获动态段（:id/:model/:name）时会先 url_decode，
// 解码值可能含 "/"（如模型名 "Qwen/Qwen3-8B"——前端 encodeURIComponent 发来的
// %2F 已被还原），直接拼进上游 URL 会把一个段拆成多段（404）或注入查询串。
// 这里对会破坏 URL 结构的字符重新编码（RFC 3986 中 /?#% 在段内均为特殊字符）；
// 其余字符（含 : @ 等 RFC 允许出现在段内的字符）原样保留。
func seg(v) {
  let s = str(v);
  let out = "";
  for (i in range(len(s))) {
    let c = substr(s, i, 1);
    if (c == "%") { out = out + "%25"; }
    else if (c == "/") { out = out + "%2F"; }
    else if (c == "?") { out = out + "%3F"; }
    else if (c == "#") { out = out + "%23"; }
    else if (c == " ") { out = out + "%20"; }
    else { out = out + c; }
  }
  return out;
}

// 转发请求体；空体补 "{}"，tsm-hub 的 handler 都接受可空 body。
func body_of(req) {
  let b = get(req, "body", null);
  if (b == null) { return "{}"; }
  let s = str(b);
  if (len(s) == 0) { return "{}"; }
  return s;
}

// 闸门拒绝时的统一 403 响应。
func deny(g) {
  return {
    status: 403,
    body: { ok: false, error: str(get(g, "reason", "写操作被审批闸门拒绝")), gate: g },
  };
}

// ---- lume agent 控制台工具（只读，框架原生 /react/api/chat 的 ReAct 循环可调用）----
// 模型上游由 LLM_API_URL / LLM_API_KEY / LLM_MODEL 决定（见 .env.example / README）。
// 这里只注册只读工具：agent 能回答「多少 key / 路由 / 用量」这类控制台问题；
// 写操作仍走下方 ?role= 闸门路由——agent 不拥有任何写权限。
// 注意：LLM_API_KEY 由 agent-httpd 在 C 层直接读取，不经过 DSL 的 env()，
// 名字含 API_KEY 不受「env() 屏蔽机密变量名」规则影响。

// fetch_json 结果转成给模型看的紧凑载荷：ok + data（失败带 status/err）。
func tool_data(r) {
  return {
    ok: get(r, "ok", false),
    status: int(get(r, "status", 0)),
    data: get(r, "data", null),
    err: str(get(r, "err", "")),
  };
}

tool "tsm_overview", "Get the tsm-hub gateway console overview: provider/route/key counts, today and total token usage and cost, provider health and recent audit logs.",
  {}, func(arg) {
    return tool_data(api.fetch_json("GET", "/api/admin/overview", null, false));
  };

tool "tsm_usage", "Get tsm-hub usage statistics aggregated per day for the last N days (1-90, default 7).",
  { days: int }, func(arg) {
    let days = int(get(arg, "days", 7));
    if (days <= 0) { days = 7; }
    if (days > 90) { days = 90; }
    return tool_data(api.fetch_json("GET", "/api/admin/usage?days=" + str(days), null, false));
  };

tool "tsm_routes", "List the tsm-hub model routing table (model -> provider targets with failover strategy).",
  {}, func(arg) {
    return tool_data(api.fetch_json("GET", "/api/admin/routes", null, false));
  };

tool "tsm_keys", "List tsm-hub issued API keys (id/name/prefix/quota/enabled; never includes plaintext keys).",
  {}, func(arg) {
    return tool_data(api.fetch_json("GET", "/api/admin/keys", null, false));
  };

tool "tsm_provider_health", "Get health status of all upstream providers (healthy/half-open, failure counts, last errors).",
  {}, func(arg) {
    return tool_data(api.fetch_json("GET", "/api/admin/health", null, false));
  };

// ---- 健康 / 元信息 / 首屏 ----
get "/api/health", (req) => {
  return api.health();
};

get "/api/meta", (req) => {
  return {
    service: "tsmhub-lume",
    upstream: api.base(),
    gate: guard.policy(),
    playground: { client_key: api.client_key_set() },
  };
};

get "/api/overview", (req) => {
  return api.overview();
};

// ---- Providers ----
get "/api/providers", (req) => {
  return api.proxy("GET", "/api/admin/providers" + qs(req), null);
};

get "/api/balances", (req) => {
  return api.proxy("GET", "/api/admin/providers/balances" + qs(req), null);
};

get "/api/models", (req) => {
