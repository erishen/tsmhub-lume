// ---- 可选 Playground：经服务端注入 sk-tr- Key ----
post "/api/chat", (req) => {
  return api.chat(body_of(req));
};

// ---- 客户端 LLM API（token 转发服务）----
// 整个 /v1/* 空间原样透传到上游：客户端用自己的 sk-tr- Key 直连 Lume
// （Authorization / X-Api-Key），上游负责 Key 鉴权 + 智能路由 + 转发。
// Lume 不做管理闸门（?role=）——这是客户端 API，鉴权在上游，与管理面分开。
// 响应按原样透传（状态码 + content-type + body）。
route "GET", "/v1/*", (req) => {
  return api.client_proxy("GET", str(get(req, "path", "/v1/")), req);
};
route "POST", "/v1/*", (req) => {
  return api.client_proxy("POST", str(get(req, "path", "/v1/")), req);
};

run();  // 注册窗口关闭，开始伺服
