// tsmhub_lume.lume — tsm-hub 的 Lume BFF + React 控制台
//
// 形态：Lume 单进程 = 静态站（www/）+ SPA 回退 + 同源 JSON API。
// 浏览器不直连 tsm-hub：所有 /api/* 在这里转发/聚合，管理口令留在服务端。
//
//   GET    /                         React 控制台
//   GET    /api/health               本服务 + 上游 tsm-hub 健康检查
//   GET    /api/meta                 上游地址 + 写操作闸门策略
//   GET    /api/overview             首屏聚合（概览/告警/健康/审计）
//   GET    /api/providers            上游 Provider 列表
//   POST   /api/providers            新增/更新 Provider（execute）
//   POST   /api/providers/probe      探测模型（execute）
//   DELETE /api/providers/:id        删除 Provider（approve）
//   GET    /api/settings /api/providers /routes /keys /usage /observability /audit-logs ...
//   POST   /api/chat                 可选 Playground（TSM_CLIENT_KEY）
//   GET/POST /v1/*                    token 转发服务：LLM 客户端 API 透传到上游 /v1/*
//
// 环境变量见 .env.example / README.md。

let lc_bind = env("LUME_BIND");
if (lc_bind == null) { lc_bind = "127.0.0.1"; }
let lc_port = env("LUME_PORT");
if (lc_port == null) { lc_port = "8097"; }

server {
  port = int(lc_port);
  workers = 2;
  bind = str(lc_bind);
  docroot = "./www";
  spa = true;                       // history 路由：GET + 静态 404 → www/index.html
  htpasswd = env("HTPASSWD_FILE");  // 本地留空 = 无认证；对外部署注入即开 Basic Auth
};

import "src/api.lume" as api;
import "src/guard.lume" as guard;

// 原样转发查询串（?days= &limit= &offset= &role= …）。
func qs(req) {
  let raw = get(req, "query", "");
  if (raw == null) { return ""; }
  let s = str(raw);
  if (len(s) == 0) { return ""; }
  return "?" + s;
}

// 转发请求体；空体补 "{}"，tsm-hub 的 handler 都接受可空 body。
func body_of(req) {
  let b = get(req, "body", null);
  if (b == null) { return "{}"; }
  let s = str(b);
  if (len(s) == 0) { return "{}"; }
  return s;
}

// 闸门拒绝时的统一 403 响应。
func deny(g) {
  return {
    status: 403,
    body: { ok: false, error: str(get(g, "reason", "写操作被审批闸门拒绝")), gate: g },
  };
}

// ---- 健康 / 元信息 / 首屏 ----
get "/api/health", (req) => {
  return api.health();
};

get "/api/meta", (req) => {
  return {
    service: "tsmhub-lume",
    upstream: api.base(),
    gate: guard.policy(),
    playground: { client_key: api.client_key_set() },
  };
};

get "/api/overview", (req) => {
  return api.overview();
};

// ---- Providers ----
get "/api/providers", (req) => {
  return api.proxy("GET", "/api/admin/providers" + qs(req), null);
};

get "/api/balances", (req) => {
  return api.proxy("GET", "/api/admin/providers/balances" + qs(req), null);
};

get "/api/models", (req) => {
  return api.proxy("GET", "/api/admin/models/catalog" + qs(req), null);
};

get "/api/models/recommendations", (req) => {
  return api.proxy("GET", "/api/admin/models/recommendations" + qs(req), null);
};

post "/api/providers/probe", (req) => {
  let g = guard.check(req, "execute");
  if (not get(g, "allowed", false)) { return deny(g); }
  return api.proxy("POST", "/api/admin/providers/probe" + qs(req), body_of(req));
};

post "/api/providers", (req) => {
  let g = guard.check(req, "execute");
  if (not get(g, "allowed", false)) { return deny(g); }
  return api.proxy("POST", "/api/admin/providers" + qs(req), body_of(req));
};

delete "/api/providers/:id", (req) => {
  let g = guard.check(req, "approve");
  if (not get(g, "allowed", false)) { return deny(g); }
  let id = str(get(req.params, "id", ""));
  return api.proxy("DELETE", "/api/admin/providers/" + id + qs(req), null);
};

